<sf-cart-selection class="sf-cart-selection">
  <label class="sf-cart-select-all"><input type="checkbox" data-sf-cart-select-all><span>Select all</span></label>
  <button type="button" class="sf-cart-remove-selected" data-sf-cart-remove-selected disabled>Remove selected</button>
  <span class="visually-hidden" role="status" data-sf-cart-selection-status></span>
</sf-cart-selection>
