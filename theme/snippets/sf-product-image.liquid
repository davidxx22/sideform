{% comment %}Generated photo assets are product-specific. Merchant product media takes precedence in Dawn.{% endcomment %}
{% assign photo_handles = 'offset-heavy-tee,plane-box-tee,axis-long-sleeve,frame-long-sleeve,volume-pullover,structure-hoodie,contour-crew,shell-utility-jacket,transit-work-jacket,grid-cargo-pant,drift-baggy-jean,interval-utility-short' | split: ',' %}
{% if photo_handles contains product.handle %}
  {% assign shade = color | default: 'black' | downcase %}
  {% assign angle = view | default: 'front' %}
  {% assign presentation = angle %}{% if angle == 'front' %}{% assign presentation = 'on-model front' %}{% endif %}
  {% assign filename = 'sf-photo-' | append: product.handle | append: '-' | append: shade | append: '-' | append: angle %}
  {% if packshot %}{% assign filename = filename | replace: 'sf-photo-', 'sf-packshot-' %}{% assign presentation = 'garment-only front' %}{% endif %}
  {% if angle == 'full' %}{% assign filename = 'sf-gallery-' | append: product.handle | append: '-' | append: shade | append: '-full' %}{% assign presentation = 'on-model full' %}{% endif %}
  {% if angle == 'lineup' %}{% assign filename = 'sf-gallery-' | append: product.handle | append: '-' | append: shade | append: '-lineup' %}{% assign presentation = 'lineup' %}{% endif %}
  {% assign paired_views = 'male,female,duolow,duofull,duoclose' | split: ',' %}
  {% if paired_views contains angle %}
    {% assign filename = 'sf-gallery-' | append: product.handle | append: '-' | append: shade | append: '-' | append: angle %}
    {% case angle %}
      {% when 'male' %}{% assign presentation = 'male half-body' %}
      {% when 'female' %}{% assign presentation = 'female half-body' %}
      {% when 'duoclose' %}{% assign presentation = 'two-model close-up' %}
      {% when 'duolow' %}{% assign presentation = 'two-model low-angle' %}
      {% when 'duofull' %}{% assign presentation = 'two-model full-body' %}
    {% endcase %}
  {% endif %}
  {% assign bottom_handles = 'grid-cargo-pant,drift-baggy-jean,interval-utility-short' | split: ',' %}
  {% if bottom_handles contains product.handle %}{% assign presentation = presentation | replace: 'half-body', 'full-body' %}{% endif %}
  {% assign full_filename = filename | append: '.webp' %}
  {% assign small_filename = filename | append: '-480.webp' %}
  <img src="{{ full_filename | asset_url }}" srcset="{{ small_filename | asset_url }} 480w, {{ full_filename | asset_url }} 1122w" sizes="{{ sizes | default: '(min-width: 990px) 25vw, 50vw' }}" width="1122" height="1402" loading="{{ loading | default: 'lazy' }}" alt="AI-generated sample photograph — {{ product.title | escape }}, {{ shade | escape }}, {{ presentation | escape }} view.">
{% else %}
  <div class="sf-sample-note">Product imagery pending — {{ product.title | escape }}. Add product photographs in Shopify.</div>
{% endif %}
