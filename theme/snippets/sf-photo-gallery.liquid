{% assign photo_handles = 'offset-heavy-tee,plane-box-tee,axis-long-sleeve,frame-long-sleeve,volume-pullover,structure-hoodie,contour-crew,shell-utility-jacket,transit-work-jacket,grid-cargo-pant,drift-baggy-jean,interval-utility-short' | split: ',' %}
{% if photo_handles contains product.handle %}
  {% assign initial_color = product.selected_or_first_available_variant.option1 | default: 'Black' | downcase %}
  <sf-photo-gallery class="sf-photo-gallery" data-color="{{ initial_color }}" data-section="{{ section.id }}">
    <div class="sf-photo-gallery__viewport">
    <div class="sf-photo-gallery__grid" tabindex="0" aria-label="Product photographs">
      {% assign views = 'front,back,detail' | split: ',' %}
      {% if product.tags contains 'sf-four-photo-gallery' %}{% assign views = 'front,full,lineup,detail' | split: ',' %}{% endif %}
      {% if product.tags contains 'tops' or product.tags contains 'outerwear' %}{% assign views = 'male,duolow,duofull,female,lineup,detail' | split: ',' %}{% endif %}
      {% assign bottom_handles = 'grid-cargo-pant,drift-baggy-jean,interval-utility-short' | split: ',' %}
      {% if bottom_handles contains product.handle %}{% assign views = 'male,duoclose,duofull,female,lineup,detail' | split: ',' %}{% endif %}
      {% if product.handle == 'interval-utility-short' %}{% assign views = 'female,duoclose,duofull,male,lineup,detail' | split: ',' %}{% endif %}
      {% for view in views %}
        {% assign view_label = view %}
        {% case view %}
          {% when 'male' %}{% assign view_label = 'male half-body' %}
          {% when 'female' %}{% assign view_label = 'female half-body' %}
          {% when 'duoclose' %}{% assign view_label = 'two-model close-up' %}
          {% when 'duolow' %}{% assign view_label = 'two-model low-angle' %}
          {% when 'duofull' %}{% assign view_label = 'two-model full-body' %}
        {% endcase %}
        {% if bottom_handles contains product.handle %}{% assign view_label = view_label | replace: 'half-body', 'full-body' %}{% endif %}
        <button class="sf-photo-gallery__tile" type="button" data-sf-view="{{ view }}" data-sf-enlarge aria-label="Enlarge {{ view_label }} photograph">
          {% render 'sf-product-image', product: product, color: initial_color, view: view, sizes: '(min-width: 990px) 30vw, (min-width: 750px) 48vw, 92vw' %}
          {% if view == 'male' or view == 'female' %}{% render 'sf-model-caption', product: product, gender: view %}{% elsif view == 'front' or view == 'full' %}{% render 'sf-model-caption', product: product %}{% endif %}
          <span class="sf-enlarge">+</span>
        </button>
      {% endfor %}
    </div>
    <div class="sf-gallery-controls" aria-label="Photo carousel controls">
      <button type="button" data-sf-gallery-step="-1" aria-label="Previous photo" disabled><svg width="12" height="20" viewBox="0 0 16 24" fill="none" aria-hidden="true"><path d="m11 5-7 7 7 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <span class="sf-gallery-counter" aria-hidden="true" data-sf-gallery-counter>1/{{ views.size }}</span>
      <button type="button" data-sf-gallery-step="1" aria-label="Next photo"><svg width="12" height="20" viewBox="0 0 16 24" fill="none" aria-hidden="true"><path d="m5 5 7 7-7 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <span class="visually-hidden" role="status" data-sf-gallery-status>Photo 1 of {{ views.size }}</span>
    </div>
    </div>
    <sf-dialog>
      <dialog class="sf-dialog sf-image-dialog" aria-label="Enlarged product photograph">
        <button type="button" data-sf-close class="sf-dialog__close" aria-label="Close enlarged image">×</button>
        <div data-sf-enlarged></div>
      </dialog>
    </sf-dialog>
  </sf-photo-gallery>
{% else %}
  <p class="sf-sample-note">Photography is not yet available for {{ product.title | escape }}. Add garment photographs in Shopify.</p>
{% endif %}
