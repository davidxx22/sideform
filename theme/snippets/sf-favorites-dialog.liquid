<dialog class="sf-dialog sf-favorites-dialog" data-sf-favorites-dialog aria-labelledby="SfFavoritesHeading">
  <button type="button" class="sf-dialog__close" data-sf-favorites-close aria-label="Close favorites">×</button>
  <h2 id="SfFavoritesHeading">Your favorites</h2>
  <p class="sf-favorites-intro">Saved on this browser for your next visit.</p>
  <div data-sf-favorites-list></div>
  <p class="visually-hidden" role="status" data-sf-favorites-status></p>
</dialog>
