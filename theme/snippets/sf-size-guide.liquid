{% assign guide = product.metafields.custom.size_guide.value %}
{% if guide.rows.size > 0 and guide.columns.size > 0 %}
 <sf-dialog class="sf-size-guide"><button type="button" class="sf-text-link" data-sf-open aria-haspopup="dialog" aria-controls="SizeGuide-{{ section.id }}">Size Guide</button>
 <dialog id="SizeGuide-{{ section.id }}" class="sf-dialog" aria-labelledby="SizeTitle-{{ section.id }}"><button type="button" data-sf-close class="sf-dialog__close" aria-label="Close size guide">×</button><p class="sf-kicker">FIND YOUR FORM</p><h2 id="SizeTitle-{{ section.id }}">{{ product.title | escape }} — Size Guide</h2><p>Garment measurements in centimeters (cm), taken flat. These describe the garment, not the wearer.</p><div class="sf-table-scroll" tabindex="0" role="region" aria-label="Size measurements"><table><caption class="visually-hidden">Garment measurements in centimeters</caption><thead><tr><th scope="col">Size</th>{% for column in guide.columns %}<th scope="col">{{ column | escape }}</th>{% endfor %}</tr></thead><tbody>{% for row in guide.rows %}<tr><th scope="row">{{ row.size | escape }}</th>{% for value in row.values %}<td>{{ value | escape }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div><h3>How to measure</h3><p>{{ guide.instructions | escape }}</p><p>Compare with a similar garment you own. Waist and hip values are flat widths; double them for approximate circumference.</p></dialog></sf-dialog>
{% endif %}