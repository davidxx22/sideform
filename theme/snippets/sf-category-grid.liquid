<template data-sf-category-grid="{{ category.url }}">
  {% assign category_section_id = section.id | append: '-' | append: category.handle %}
  {% for product in category.products limit: section.settings.products_to_show %}
    <li class="grid__item" id="Slide-{{ category_section_id }}-{{ forloop.index }}">
      {% render 'card-product', card_product: product, media_aspect_ratio: section.settings.image_ratio, image_shape: section.settings.image_shape, lazy_load: true, show_secondary_image: false, show_vendor: section.settings.show_vendor, show_rating: section.settings.show_rating, skip_styles: true, section_id: category_section_id, quick_add: 'none', sf_color_index: forloop.index0, product_view_context: 'collection' %}
    </li>
  {% else %}<li class="sf-category-empty">No pieces in this edit yet. Choose another category to keep browsing.</li>{% endfor %}
</template>
