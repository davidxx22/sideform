{% if product.tags contains 'sample-data' %}<p class="sf-sample-note">Sample product · illustrative inventory, materials, pricing, and sizing require merchant verification.</p>{% endif %}{% assign details = 'material,fit,care' | split: ',' %}{% for key in details %}{% assign detail = product.metafields.custom[key].value %}{% if detail != blank %}<details class="sf-detail"><summary>{{ key | capitalize }}</summary><p>{{ detail | escape | newline_to_br }}</p></details>{% endif %}{% endfor %}