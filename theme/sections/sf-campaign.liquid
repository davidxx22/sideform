<section class="sf-campaign" style="--sf-position:{{ section.settings.position }}%;--sf-mobile-position:{{ section.settings.mobile_position }}%;--sf-ink:{{ section.settings.text_color }};--sf-space:{{ section.settings.spacing }}px">
  <div class="sf-campaign__image{% if section.settings.mobile_image != blank %} sf-has-mobile{% endif %}">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'sf-campaign__desktop', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}
    {% endif %}
    {% if section.settings.mobile_image != blank %}{{ section.settings.mobile_image | image_url: width: 1200 | image_tag: class: 'sf-campaign__mobile', widths: '450, 750, 1200', sizes: '100vw', loading: 'eager' }}{% endif %}
  </div>
  <div class="sf-campaign__copy">
    {% if section.settings.eyebrow != blank %}<p class="sf-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
    <p>{{ section.settings.text | escape }}</p>
    {% if section.settings.link != blank %}<a class="button" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>{% endif %}
  </div>
  <div class="sf-campaign__caption"><span>SIDEFORM</span><span>FORM / FUNCTION / EVERYDAY</span></div>
</section>
{% schema %}
{
  "name": "SIDEFORM campaign",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop campaign photograph"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Separate mobile photograph"
    },
    {
      "type": "range",
      "id": "position",
      "label": "Desktop image position",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "mobile_position",
      "label": "Mobile image position",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 75,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Headline",
      "default": "Your own\nform."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting copy",
      "default": "Room to move. Space to be yourself."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Collection link",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Desktop text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Copy spacing",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "SIDEFORM campaign"
    }
  ]
}
{% endschema %}
