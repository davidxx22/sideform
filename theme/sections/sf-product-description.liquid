{% assign shade = product.selected_or_first_available_variant.option1 | default: 'Black' | downcase %}
<section class="sf-product-description page-width" style="--sf-description-spacing:{{ section.settings.spacing }}px">
  <h2>{{ section.settings.heading | escape }}</h2>
  <p class="sf-product-id">Product ID: {{ product.id }}</p>
  <details class="sf-description-accordion">
    <summary>Features<span aria-hidden="true"></span></summary>
    <div class="sf-feature-grid">
      {% assign feature_keys = 'material,fit' | split: ',' %}
      {% for key in feature_keys %}
        {% assign feature = product.metafields.custom[key].value %}
        {% if feature != blank %}<article class="sf-feature">
          {% if product.tags contains 'ai-sample-media' %}<div data-sf-feature-photo>{% if key == 'material' %}{% render 'sf-product-image', product: product, color: shade, view: 'detail', sizes: '(min-width: 990px) 15vw, 35vw' %}{% else %}{% render 'sf-product-image', product: product, color: shade, view: 'front', packshot: true, sizes: '(min-width: 990px) 15vw, 35vw' %}{% endif %}</div>{% endif %}
          <div><h3>{{ key | capitalize }}</h3><p>{{ feature | escape }}</p></div>
        </article>{% endif %}
      {% endfor %}
    </div>
  </details>
  <details class="sf-description-accordion"><summary>Details<span aria-hidden="true"></span></summary><div class="rte">{{ product.description }}</div></details>
  <details class="sf-description-accordion"><summary>Material / Care<span aria-hidden="true"></span></summary><p>{{ product.metafields.custom.material.value | escape }}</p><p>{{ product.metafields.custom.care.value | escape }}</p></details>
  {% if shop.shipping_policy.body != blank or shop.refund_policy.body != blank %}<details class="sf-description-accordion"><summary>Delivery / Exchange / Return<span aria-hidden="true"></span></summary>{% if shop.shipping_policy.body != blank %}<p><a href="{{ shop.shipping_policy.url }}">Shipping and delivery</a></p>{% endif %}{% if shop.refund_policy.body != blank %}<p><a href="{{ shop.refund_policy.url }}">Returns and exchanges</a></p>{% endif %}</details>{% endif %}
</section>
{% schema %}
{"name":"SIDEFORM product features","settings":[{"type":"text","id":"heading","label":"Heading","default":"Description"},{"type":"range","id":"spacing","label":"Vertical spacing","min":20,"max":100,"step":4,"default":48,"unit":"px"}],"presets":[{"name":"SIDEFORM product features"}]}
{% endschema %}
