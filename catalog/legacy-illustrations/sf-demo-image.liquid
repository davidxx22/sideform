{% assign kind = product.type | handleize %}{% assign known = 'oversized-t-shirt,long-sleeve-t-shirt,hoodie,crewneck-sweatshirt,streetwear-jacket,cargo-pants,baggy-jeans,streetwear-shorts' | split: ',' %}{% if known contains kind %}{% assign shade = color | default: 'black' | downcase %}{% assign filename = 'sf-demo-' | append: kind | append: '-' | append: shade | append: '-' | append: view | append: '.svg' %}<img src="{{ filename | asset_url }}" width="700" height="850" loading="{{ loading | default: 'lazy' }}" alt="Demo illustration — {{ product.title | escape }}, {{ shade | escape }}, {{ view | escape }} view. Replace with verified photography.">{% else %}<div class="sf-sample-note">Product imagery pending — {{ product.title | escape }}. Upload verified product photographs.</div>{% endif %}