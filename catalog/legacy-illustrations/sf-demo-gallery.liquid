{% assign kind = product.type | handleize %}{% assign known = 'oversized-t-shirt,long-sleeve-t-shirt,hoodie,crewneck-sweatshirt,streetwear-jacket,cargo-pants,baggy-jeans,streetwear-shorts' | split: ',' %}{% if known contains kind %}<sf-demo-gallery class="sf-demo-gallery" data-section="{{ section.id }}"><p class="sf-sample-note">Demo illustrations · photography required</p><button class="sf-demo-gallery__main" type="button" data-sf-enlarge aria-label="Enlarge product illustration"><span data-sf-main>{% render 'sf-demo-image', product: product, color: 'black', view: 'front', loading: 'eager' %}</span><span class="sf-enlarge">Enlarge +</span></button><div class="sf-demo-gallery__thumbs" aria-label="Product views">{% assign views = 'front,back,detail' | split: ',' %}{% for view in views %}<button type="button" data-sf-view="{{ view }}" aria-label="Show {{ view }} view"{% if forloop.first %} aria-current="true"{% endif %}>{% render 'sf-demo-image', product: product, color: 'black', view: view %}</button>{% endfor %}</div><sf-dialog><dialog class="sf-dialog sf-image-dialog" aria-label="Enlarged product illustration"><button type="button" data-sf-close class="sf-dialog__close" aria-label="Close enlarged image">×</button><div data-sf-enlarged></div></dialog></sf-dialog></sf-demo-gallery>{% else %}<p class="sf-sample-note">Photography is not yet available for {{ product.title | escape }}. Upload verified garment photographs in Shopify.</p>{% endif %}